#!/bin/bash

script_name=${0##*/}					#build.sh
script_full=`realpath $0`				#/path/build.sh
script_path=`dirname "$script_full"` 	#/path/
dir_name=`basename "$script_path"`		#Project base dir

print_library () {
	echo -e "\033[1m\033[32m$1\033[0m"
}

libraries_path="$script_path/lps_libraries"

libraries=()

for dir in "$libraries_path"/*/; do
    [ -d "$dir" ] || continue
    libraries+=("$(basename "$dir")")
done

case "$1" in
	install)
		print_library "$dir_name"
		cd "$script_path/src"
		pip install -e . --user

		for sub in "${libraries[@]}"
		do
			print_library $sub
			cd "$script_path/$sub/src"
			pip install -e . --user
		done
	;;

	todo)
		for sub in "${libraries[@]}"
		do
			cd "$script_path/$sub"
			grep --color -nR TODO

		done
	;;

	count)
		for sub in "${libraries[@]}"
		do
			print_library $sub
			cd "$script_path/$sub"
			find . -path './*.py' | xargs wc -l | tail -n 1
		done

		print_library $dir_name
		cd "$script_path"
		find . -path './lps_libraries' -prune -o -name '*.py' -print | xargs wc -l | tail -n 1
	;;

	list)
		echo install todo count
	;;

	*)
		echo "$script_name {install | todo | count}"
		echo "Details in: $script_full"
		exit 1
	;;
esac

exit 0

